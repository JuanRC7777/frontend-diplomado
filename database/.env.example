# Copia este archivo a .env (en la raíz del backend) y completa
# los valores reales. .env NUNCA se commitea (ver .gitignore).

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pawcare
DB_USER=pawcare_app
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA_2026!
DB_SSL=true

# --- JWT ---
# Genera un secreto aleatorio de al menos 32 bytes, por ejemplo:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=reemplaza_con_openssl_rand_base64_48
JWT_ACCESS_EXPIRES=15m

JWT_REFRESH_SECRET=reemplaza_con_otro_secreto_distinto
JWT_REFRESH_EXPIRES=7d

# --- Hash de contraseñas ---
BCRYPT_SALT_ROUNDS=12
