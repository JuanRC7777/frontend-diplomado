# Copia este archivo a .env en esta misma carpeta y completa los
# valores reales. .env NUNCA se commitea (ver .gitignore de la raíz).

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Base de datos (mismo usuario creado en database/00_setup.sql) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pawcare
DB_USER=pawcare_app
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA_2026!
DB_SSL=true

# --- JWT ---
# Genera cada secreto por separado con: openssl rand -base64 48
JWT_ACCESS_SECRET=reemplaza_con_openssl_rand_base64_48
JWT_ACCESS_EXPIRES=15m

JWT_REFRESH_EXPIRES_DAYS=7

# --- Hash de contraseñas ---
BCRYPT_SALT_ROUNDS=12
